---
import ThemeToggle from '@/components/ThemeToggle.astro';
import '@/styles.css';

interface Props {
  title?: string;
  description?: string;
  hasPublishedNotes?: boolean;
}

const {
  title = 'Alberto Diaz-Tostado — Product Engineer',
  description = 'Alberto Diaz-Tostado is a product engineer building growth experiences and the platform foundations behind them.',
  hasPublishedNotes = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const navItems = [
  { href: '#currently', label: 'Currently' },
  { href: '#what-i-do', label: 'What I do' },
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  ...(hasPublishedNotes ? [{ href: '#notes', label: 'Notes' }] : []),
  { href: '#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#faf8f4" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.svg', Astro.site)} />
    <script is:inline>
      const preference = localStorage.getItem('theme-preference') || 'system';
      const dark = preference === 'dark' || (preference === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-border/70 bg-canvas/85 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8" aria-label="Primary navigation">
        <a class="focus-ring text-sm font-bold tracking-tight text-text" href="/">ADT</a>
        <div class="hidden items-center gap-5 md:flex">
          {navItems.map((item) => <a class="text-sm font-medium text-muted transition hover:text-text" href={item.href}>{item.label}</a>)}
        </div>
        <ThemeToggle />
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-5 sm:px-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-5 pb-10 pt-4 text-sm text-muted sm:px-8">
      <div class="border-t border-border pt-8">© {new Date().getFullYear()} Alberto Diaz-Tostado. Built with Astro and deployed on GitHub Pages.</div>
    </footer>
  </body>
</html>
