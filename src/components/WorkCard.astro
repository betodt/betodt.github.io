---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { data } = entry;
---
<article class="card flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:border-accent/40">
  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{data.eyebrow}</p>
  <h3 class="mt-4 text-2xl font-semibold tracking-tight">{data.title}</h3>
  <p class="mt-3 leading-7 text-muted">{data.summary}</p>
  <ul class="mt-6 space-y-3 text-sm text-muted">
    {data.outcomes.map((outcome) => (
      <li class="flex gap-3 leading-6"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{outcome}</span></li>
    ))}
  </ul>
  <div class="mt-6 flex flex-wrap gap-2">
    {data.tags.map((tag) => (
      <span class="rounded-full border border-border bg-canvas/60 px-3 py-1 text-xs font-medium text-muted">{tag}</span>
    ))}
  </div>
</article>
