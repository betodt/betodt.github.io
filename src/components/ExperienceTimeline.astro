---
const roles = [
  {
    company: 'Databricks',
    role: 'Senior Software Engineer, Growth',
    period: '2023–Present',
    bullets: [
      'Working on Free Edition product experiences that improve onboarding and lower the barrier to entry for new users.',
      'Built GraphQL-based data fetching and static asset infrastructure across product surfaces.',
      'Reduced latency by up to 15% across multiple high-visibility workflows through a platform-level solution.',
    ],
  },
  {
    company: 'Clari',
    role: 'Engineering Manager / Senior Software Engineer',
    period: '2018–2023',
    bullets: [
      'Founded and led the Frontend Infrastructure team to improve shared UI, tooling, and frontend architecture.',
      'Built reusable components, a design system, and a GraphQL service layer for product teams.',
      'Led adoption of GraphQL and React hooks while mentoring engineers through implementation and design reviews.',
    ],
  },
  {
    company: 'Santa Clara University',
    role: 'Adjunct Lecturer',
    period: '2018–2022',
    bullets: [
      'Taught web programming with an emphasis on practical frontend fundamentals and modern application development.',
    ],
  },
  {
    company: 'E*TRADE',
    role: 'Software Engineer',
    period: '2017–2019',
    bullets: [
      'Built customer-facing software and strengthened frontend engineering foundations early in my product engineering career.',
    ],
  },
];
---
<section id="experience" class="py-16 sm:py-24">
  <div class="max-w-3xl">
    <p class="section-label">Selected experience</p>
    <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">A track record across growth, platform, and frontend systems.</h2>
  </div>
  <div class="mt-12 space-y-5">
    {roles.map((role) => (
      <article class="card p-6 sm:p-8">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
          <div>
            <h3 class="text-2xl font-semibold tracking-tight">{role.company}</h3>
            <p class="mt-1 font-medium text-accent">{role.role}</p>
          </div>
          <p class="text-sm font-semibold text-muted">{role.period}</p>
        </div>
        <ul class="mt-5 space-y-3 text-muted">
          {role.bullets.map((bullet) => (
            <li class="flex gap-3 leading-7"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{bullet}</span></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
