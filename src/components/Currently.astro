---
const items = [
  ['Working on', 'Growth product experiences at Databricks, with a focus on Free Edition and lowering the barrier to entry for new users.'],
  ['Thinking about', 'Product-led growth, frontend architecture, platform leverage, and how better systems create better user experiences.'],
  ['Exploring', 'Placeholder for now. Revisit later.'],
  ['Based in', 'San Francisco.'],
];
---
<section id="currently" class="py-12 sm:py-16">
  <div class="card p-6 sm:p-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="section-label">Currently</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">What has my attention right now</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-muted">A compact personal OS for the work, questions, and context shaping my engineering practice.</p>
    </div>
    <dl class="mt-8 grid gap-4 md:grid-cols-2">
      {items.map(([label, value]) => (
        <div class="rounded-2xl border border-border/70 bg-canvas/50 p-5">
          <dt class="text-sm font-semibold text-text">{label}</dt>
          <dd class="mt-2 text-sm leading-6 text-muted">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
