---
import { getCollection } from 'astro:content';
import Contact from '@/components/Contact.astro';
import Currently from '@/components/Currently.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import Hero from '@/components/Hero.astro';
import WhatIDo from '@/components/WhatIDo.astro';
import WorkCard from '@/components/WorkCard.astro';
import Layout from '@/layouts/Layout.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const publishedNotes = (await getCollection('notes')).filter((note) => !note.data.draft);
---
<Layout hasPublishedNotes={publishedNotes.length > 0}>
  <Hero />
  <Currently />
  <WhatIDo />
  <ExperienceTimeline />
  <section id="work" class="py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="section-label">Selected work</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Case-study-shaped snapshots, ready for deeper writeups later.</h2>
      <p class="mt-5 text-lg leading-8 text-muted">These are intentionally concise: enough context to show the kind of product and platform problems I take on, without turning the homepage into a resume dump.</p>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>
  {publishedNotes.length > 0 && (
    <section id="notes" class="py-16 sm:py-24">
      <div class="max-w-3xl">
        <p class="section-label">Notes</p>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Recent writing</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {publishedNotes.map((note) => (
          <article class="card p-6">
            <p class="text-sm text-muted">{note.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
            <h3 class="mt-3 text-2xl font-semibold tracking-tight">{note.data.title}</h3>
            <p class="mt-3 leading-7 text-muted">{note.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}
  <Contact />
</Layout>
